{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "baseline-experiment-v0.1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "dev_manifest", "test_manifest", "worlds", "dev_episodes_per_world", "test_episodes_per_world", "steps", "run_seeds", "parameter_target", "compute_target", "optimizer_steps", "learning_rate", "torch_threads", "trial_budget_per_family", "context_limit", "hard_timeout_seconds"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "profile": {"enum": ["smoke", "acceptance"]},
    "dev_manifest": {"type": "string"},
    "test_manifest": {"type": "string"},
    "worlds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "dev_episodes_per_world": {"type": "integer", "minimum": 2},
    "test_episodes_per_world": {"type": "integer", "minimum": 1},
    "steps": {"type": "integer", "minimum": 2},
    "run_seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
    "parameter_target": {"type": "integer", "minimum": 1},
    "compute_target": {"type": "integer", "minimum": 1},
    "optimizer_steps": {"type": "integer", "minimum": 1},
    "learning_rate": {"type": "number", "exclusiveMinimum": 0},
    "torch_threads": {"type": "integer", "minimum": 1},
    "trial_budget_per_family": {"const": 12},
    "context_limit": {"const": 64},
    "hard_timeout_seconds": {"type": "number", "minimum": 1}
  }
}
