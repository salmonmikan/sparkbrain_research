{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkbrain.local/schemas/phase1-run-manifest-v0.2.schema.json",
  "title": "SparkBrain Phase-1 run manifest v0.2",
  "type": "object",
  "required": ["schema_version", "run_id", "git_commit", "config_hash", "split_hash", "command", "local_execution", "completed", "episode_count", "failed_episode_count"],
  "properties": {
    "schema_version": {"const": "0.2"}, "run_id": {"type": "string"}, "git_commit": {"type": "string"}, "config_hash": {"type": "string"}, "split_hash": {"type": "string"}, "command": {"type": "string"}, "local_execution": {"const": true}, "completed": {"type": "boolean"}, "episode_count": {"type": "integer", "minimum": 0}, "failed_episode_count": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
