{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkbrain.local/schemas/trace-v0.2.schema.json",
  "title": "SparkBrain Trace v0.2",
  "type": "object",
  "required": ["schema_version", "graph", "frames", "ignitions"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "graph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "kind", "organ"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "label": {"type": "string"},
              "kind": {"type": "string"},
              "organ": {"type": "string"}
            },
            "additionalProperties": true
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "target", "weight"],
            "properties": {
              "source": {"type": "string"},
              "target": {"type": "string"},
              "weight": {"type": "number"}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "frames": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "time", "external_event", "prediction", "sparks", "coalitions",
          "workspace", "fired", "active_edges", "stats"
        ],
        "properties": {
          "time": {"type": "number"},
          "external_event": {"type": "string"},
          "truth": {"type": ["string", "null"]},
          "prediction": {"type": ["string", "null"]},
          "sparks": {"type": "array"},
          "coalitions": {"type": "array"},
          "workspace": {"type": "array"},
          "fired": {"type": "array", "items": {"type": "string"}},
          "active_edges": {"type": "array"},
          "stats": {"type": "object"}
        },
        "additionalProperties": true
      }
    },
    "ignitions": {"type": "array"}
  },
  "additionalProperties": false
}
