{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sparkbrain.local/schemas/episode-v0.2.schema.json",
  "title": "SparkBrain episode v0.2",
  "type": "object",
  "required": ["schema_version", "episode_id", "world_id", "world_version", "split", "seed", "generator_config_hash", "steps"],
  "properties": {
    "schema_version": {"const": "0.2"},
    "episode_id": {"type": "string", "minLength": 1},
    "world_id": {"type": "string", "minLength": 1},
    "world_version": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "dev", "test", "smoke"]},
    "seed": {"type": "integer"},
    "generator_config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "steps": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["observation", "target"], "additionalProperties": false, "properties": {"observation": {"type": "object"}, "target": {"type": "object"}}}}
  },
  "additionalProperties": false
}
